// Transport bar (Phase 7.2): the studio-style control cluster from the
// reference — filled colored buttons (play green, record red, rewind/FF
// amber), a dark LCD time display (current / total, mono digits), the
// master volume and live L/R output meters.
//
// Every element is real (No-Fake-UI): buttons drive the cpal transport;
// the meters read the output tap (post-render, pre-DAC) published by the
// audio callback; the volume slider sets the output gain in the same
// callback; the time display mirrors player position. LTR button order
// is kept in both languages (the time axis stays LTR; disclosed in the
// phase report) but the row itself mirrors via layout-order.

import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";

// Filled transport button: saturated rounded square with a dark glyph.
component TransportButton inherits Rectangle {
    width: root.size;
    height: root.size;
    border-radius: Tokens.radius-md;
    background: touch.pressed ? root.press
        : touch.has-hover ? root.fill
        : root.fill;

    in property <length> size: 44px;
    in property <color> fill: Tokens.bg-elevated-hover;
    in property <color> press: Tokens.bg-elevated-press;
    in property <string> icon;
    in property <color> glyph: Tokens.bg-base;
    in property <bool> enabled: true;
    callback clicked;

    opacity: root.enabled ? 1.0 : 0.35;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Path {
        width: root.size * 0.44;
        height: root.size * 0.44;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        fill: root.glyph;
        viewbox-width: 16;
        viewbox-height: 16;
    }

    animate background { duration: Tokens.anim-fast; easing: Tokens.motion; }
}

// One horizontal output meter: a fixed gradient scale (green → yellow →
// red zones) masked by the live level, plus a peak-hold tick. `level`
// 0..1, `peak` 0..1 (both real values from the output tap).
component OutputMeter inherits Rectangle {
    height: 10px;
    border-radius: 2px;
    background: Tokens.vu-off;
    clip: true;

    in property <float> level: 0.0;
    in property <float> peak: 0.0;

    // Full gradient scale (always painted underneath).
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;

        Rectangle { width: parent.width * 0.60; height: parent.height; background: Tokens.vu-green; }
        Rectangle { x: parent.width * 0.60; width: parent.width * 0.25; height: parent.height; background: Tokens.vu-yellow; }
        Rectangle { x: parent.width * 0.85; width: parent.width * 0.15; height: parent.height; background: Tokens.vu-red; }
    }

    // Unlit cover from the current level to the right edge.
    Rectangle {
        x: root.level * parent.width;
        width: (1.0 - root.level).clamp(0.0, 1.0) * parent.width;
        height: parent.height;
        background: Tokens.vu-off;
    }

    // Peak-hold tick.
    if root.peak > 0.01: Rectangle {
        x: root.peak * (parent.width - 2px);
        width: 2px;
        height: parent.height;
        background: root.peak > 0.85 ? Tokens.vu-red : Tokens.text-primary;
    }
}

export component TransportBar inherits Rectangle {
    height: 72px;
    background: Tokens.bg-elevated;

    in property <bool> has-project: false;
    in property <bool> playing: false;
    in property <bool> recording: false;
    // Split LCD readouts (LTR digits in both languages).
    in property <string> time-cur: "00:00:00.000";
    in property <string> time-total: "00:00:00.000";
    // Master output volume 0..1.5 (1.0 = unity), real gain in the
    // output callback; slider mirrors the value the engine holds.
    in-out property <float> volume: 1.0;
    callback volume-changed(float);
    // Live output meter state 0..1 (post-render tap).
    in property <float> meter-l: 0.0;
    in property <float> meter-r: 0.0;
    in property <float> peak-l: 0.0;
    in property <float> peak-r: 0.0;
    in property <string> t-record;

    callback play-pause();
    callback stop();
    callback rewind();       // to start
    callback forward();      // +5 s (streaming: restart at playhead+5 s)
    callback record-toggle();

    HorizontalLayout {
        padding-left: Tokens.sp-2;
        padding-right: Tokens.sp-2;
        spacing: Tokens.sp-2;

        // ── Buttons cluster ─────────────────────────────────────────
        Rectangle {
            layout-order: 0;
            width: btn-row.preferred-width + Tokens.sp-1;

            btn-row := HorizontalLayout {
                y: (parent.height - self.height) / 2;
                spacing: Tokens.sp-1;
                alignment: start;

                // |◀ rewind to start — amber glyph on dark fill.
                TransportButton {
                    icon: Icons.rewind;
                    fill: Tokens.bg-elevated-hover;
                    press: Tokens.bg-elevated-press;
                    glyph: Tokens.state-warn;
                    enabled: root.has-project;
                    clicked => { root.rewind(); }
                }

                // ▶ / ❚❚ — green fill, dark glyph (the reference look).
                TransportButton {
                    size: 56px;
                    icon: root.playing ? Icons.pause : Icons.play;
                    fill: Tokens.state-play;
                    press: Tokens.state-play-press;
                    glyph: Tokens.bg-base;
                    enabled: root.has-project;
                    clicked => { root.play-pause(); }
                }

                // ■ stop — dark fill, light glyph.
                TransportButton {
                    icon: Icons.stop;
                    fill: Tokens.bg-elevated-hover;
                    press: Tokens.bg-elevated-press;
                    glyph: Tokens.text-primary;
                    enabled: root.has-project;
                    clicked => { root.stop(); }
                }

                // ● record — red fill while armed (pulse via opacity).
                rec-btn := TransportButton {
                    size: 48px;
                    icon: Icons.record;
                    fill: Tokens.state-record;
                    press: Tokens.state-record-press;
                    glyph: root.recording ? Tokens.state-record : Tokens.bg-base;
                    enabled: root.has-project;
                    clicked => { root.record-toggle(); }
                }

                // ▶| forward 5 s — amber glyph on dark fill.
                TransportButton {
                    icon: Icons.forward;
                    fill: Tokens.bg-elevated-hover;
                    press: Tokens.bg-elevated-press;
                    glyph: Tokens.state-warn;
                    enabled: root.has-project;
                    clicked => { root.forward(); }
                }
            }
        }

        // ── LCD time display ────────────────────────────────────────
        Rectangle {
            layout-order: 1;
            width: 250px;
            height: 48px;
            y: (parent.height - 48px) / 2;
            border-radius: Tokens.radius-sm;
            background: Tokens.bg-lcd;
            border-width: 1px;
            border-color: Tokens.border-subtle;

            VerticalLayout {
                padding-left: Tokens.sp-1;
                padding-right: Tokens.sp-1;
                alignment: center;
                spacing: 0;

                HorizontalLayout {
                    alignment: start;
                    Text {
                        text: root.time-cur;
                        color: Tokens.lcd-text;
                        font-family: Tokens.font-mono;
                        font-size: 20px;
                        font-weight: 500;
                    }
                    Rectangle { width: Tokens.sp-1; }
                    Text {
                        text: "/ " + root.time-total;
                        color: Tokens.text-muted;
                        font-family: Tokens.font-mono;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.recording ? root.t-record : "PROJECT TIME";
                    color: root.recording ? Tokens.state-record : Tokens.text-faint;
                    font-family: Tokens.font-mono;
                    font-size: 9px;
                    letter-spacing: 2px;
                    horizontal-alignment: left;
                }
            }
        }

        // ── Master volume ───────────────────────────────────────────
        Rectangle {
            layout-order: 2;
            width: 190px;
            height: 40px;
            y: (parent.height - 40px) / 2;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "MASTER";
                    color: Tokens.text-faint;
                    font-family: Tokens.font-mono;
                    font-size: 9px;
                    letter-spacing: 2px;
                }

                slider := Rectangle {
                    height: 14px;
                    border-radius: 7px;
                    background: Tokens.vu-off;

                    property <length> track-w: self.width - 14px;

                    touch := TouchArea {
                        changed mouse-x => {
                            if (self.pressed) {
                                root.volume-changed(
                                    (self.mouse-x / (slider.width - 14px)).clamp(0.0, 1.0) * 1.5
                                );
                            }
                        }
                    }

                    // Unity tick (1.0 of the 0..1.5 range = 2/3).
                    Rectangle {
                        x: slider.track-w * (2 / 3) + 7px - 1px;
                        y: 1px;
                        width: 1px;
                        height: parent.height - 2px;
                        background: Tokens.text-faint;
                    }

                    Rectangle {
                        y: (parent.height - 6px) / 2;
                        x: 7px;
                        width: root.volume / 1.5 * slider.track-w;
                        height: 6px;
                        border-radius: 3px;
                        background: Tokens.accent-pitch;
                    }

                    Rectangle {
                        y: 0;
                        width: 14px;
                        height: 14px;
                        x: root.volume / 1.5 * slider.track-w;
                        border-radius: 7px;
                        background: Tokens.text-primary;
                        border-width: 1px;
                        border-color: Tokens.border-subtle;
                    }
                }
            }
        }

        Rectangle { layout-order: 3; } // spring

        // ── L/R output meters ───────────────────────────────────────
        Rectangle {
            layout-order: 4;
            width: 170px;
            height: 34px;
            y: (parent.height - 34px) / 2;

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                HorizontalLayout {
                    spacing: Tokens.sp-half;
                    Text {
                        text: "L";
                        color: Tokens.text-muted;
                        font-family: Tokens.font-mono;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    OutputMeter { level: root.meter-l; peak: root.peak-l; }
                }

                HorizontalLayout {
                    spacing: Tokens.sp-half;
                    Text {
                        text: "R";
                        color: Tokens.text-muted;
                        font-family: Tokens.font-mono;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    OutputMeter { level: root.meter-r; peak: root.peak-r; }
                }
            }
        }
    }

    // Record pulse: the armed record button breathes via opacity.
    states [
        recording when root.recording: {
            rec-btn.opacity: 0.72;
            in {
                animate rec-btn.opacity { duration: 600ms; iteration-count: -1; direction: alternate; }
            }
        }
    ]
}
