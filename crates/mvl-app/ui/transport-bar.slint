// Transport bar: record, rewind-to-start, play/pause, stop, time readout.
// Every button is wired to the real cpal transport (No-Fake-UI).

import { Tokens } from "tokens.slint";
import { Icons, IconButton } from "icons.slint";

export component TransportBar inherits Rectangle {
    height: 52px;
    background: Tokens.bg-base;

    in property <bool> has-project: false;
    in property <bool> playing: false;
    in property <bool> recording: false;
    in property <string> time-readout;
    in property <string> t-record;
    in property <bool> rtl;
    // Transport commands (handled in Rust).
    callback play-pause();
    callback stop();
    callback rewind();
    callback record-toggle();

    HorizontalLayout {
        padding-left: Tokens.sp-2;
        padding-right: Tokens.sp-2;
        spacing: Tokens.sp-1;
        alignment: start;

        // Record: red glyph while armed, pulses via opacity animation.
        // layout-order fully mirrors the row in RTL: LTR is
        // [rec rewind play stop readout spring rec-text], RTL is the exact
        // reverse (glyphs keep their playback-direction meaning: the time
        // axis stays LTR in both languages, disclosed in the phase report).
        rec := IconButton {
            layout-order: root.rtl ? 6 : 0;
            icon: Icons.record;
            glyph: root.recording ? Tokens.state-record : Tokens.text-primary;
            enabled: root.has-project;
            clicked => { root.record-toggle(); }
        }

        IconButton {
            layout-order: root.rtl ? 5 : 1;
            icon: Icons.rewind;
            enabled: root.has-project;
            clicked => { root.rewind(); }
        }

        playbtn := IconButton {
            layout-order: root.rtl ? 4 : 2;
            icon: root.playing ? Icons.pause : Icons.play;
            glyph: root.playing ? Tokens.state-play : Tokens.text-primary;
            enabled: root.has-project;
            clicked => { root.play-pause(); }
        }

        IconButton {
            layout-order: root.rtl ? 3 : 3;
            icon: Icons.stop;
            enabled: root.has-project;
            clicked => { root.stop(); }
        }

        // Time readout (fixed box, LTR digits both directions).
        Text {
            layout-order: root.rtl ? 2 : 4;
            text: root.time-readout;
            color: Tokens.text-primary;
            font-size: Tokens.font-size-readout;
            vertical-alignment: center;
            width: 180px;
            horizontal-alignment: center;
        }

        Rectangle { layout-order: root.rtl ? 1 : 5; } // spring

        if root.recording: Text {
            layout-order: root.rtl ? 0 : 6;
            text: root.t-record;
            color: Tokens.state-record;
            vertical-alignment: center;
            animate opacity { duration: 300ms; iteration-count: 2; direction: alternate; }
        }
    }
}
